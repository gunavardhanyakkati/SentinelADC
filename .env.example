# ─── SentinelADC Gateway Configuration ───────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# TLS / HTTPS Termination
TLS_ENABLED=false
TLS_PORT=8443
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt
TLS_REDIRECT=false

# Logging
LOG_LEVEL=info

# ─── Backend Pool ────────────────────────────────────────────────────────────
# Comma-separated list of backend URLs
BACKENDS=http://localhost:4001,http://localhost:4002,http://localhost:4003

# ─── Load Balancing ─────────────────────────────────────────────────────────
# Options: round-robin, least-connections, weighted-round-robin, ip-hash
LB_ALGORITHM=round-robin

# ─── Health Monitoring ──────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=5000
HEALTH_CHECK_TIMEOUT=3000
HEALTH_CHECK_PATH=/health
UNHEALTHY_THRESHOLD=3
HEALTHY_THRESHOLD=2

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=60
CACHE_ENABLED=true

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sentinel-adc
ANALYTICS_RETENTION_DAYS=7

# ─── Security ──────────────────────────────────────────────────────────────
JWT_SECRET=sentinel-adc-secret-change-in-production
JWT_EXPIRY=1h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Statistical Anomaly Detection (EWMA / Z-Score)
ANOMALY_DETECTION_ENABLED=true
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_AUTO_ENFORCE=false
ANOMALY_PENALTY_MAX_REQUESTS=10
ANOMALY_PENALTY_WINDOW_MS=300000

# Upstream Circuit Breaker (Fast Failure Protection)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=15000
CIRCUIT_BREAKER_HALF_OPEN_PROBES=1

# ─── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_PORT=5173
CORS_ORIGIN=http://localhost:5173
